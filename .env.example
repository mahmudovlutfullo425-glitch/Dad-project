# ---- Postgres ----
POSTGRES_USER=ecom
POSTGRES_PASSWORD=ecom_dev_password
POSTGRES_DB=ecommerce
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379

# ---- Meilisearch ----
MEILI_HOST=meilisearch
MEILI_PORT=7700
MEILI_MASTER_KEY=dev_master_key_change_me

# ---- ClickHouse ----
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=ecom
CLICKHOUSE_PASSWORD=ecom_dev_password
CLICKHOUSE_DB=analytics

# ---- NATS ----
NATS_URL=nats://nats:4222

# ---- API ----
API_PORT=8000
JWT_SECRET=change_me_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# ---- Inventory service ----
INVENTORY_GRPC_PORT=50051
INVENTORY_HOST=inventory

# ---- Gateway ----
GATEWAY_HTTP_PORT=80
GATEWAY_HTTPS_PORT=443

# ---- Production gateway (Step 16, --profile prod / `make up-prod`) ----
# Caddy reads PUBLIC_HOSTNAME at start, requests a Let's Encrypt cert
# for it (HTTP-01 challenge on :80), then serves the storefront and api
# on https://${PUBLIC_HOSTNAME}/.
#
# Quick-path for a coursework demo: use <droplet-ip>.nip.io (e.g.
# 134.122.45.10.nip.io). nip.io is a public wildcard DNS service that
# resolves anything matching <ip>.nip.io back to <ip>, so no domain
# purchase or DNS setup is required.
#
# For a real domain, point an A record at the droplet IP and put the
# domain here instead. Either way, do NOT include the scheme or a
# trailing slash.
PUBLIC_HOSTNAME=your-droplet-ip.nip.io

# ACME contact email — used by Let's Encrypt to notify you about
# upcoming cert expirations if the auto-renew ever fails.
ADMIN_EMAIL=admin@example.com

# ---- Observability ----
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAMESPACE=ecommerce

# ---- Frontend ----
# In dev (Nginx gateway, no TLS): http://localhost/api
# In prod (Caddy gateway on the droplet): https://${PUBLIC_HOSTNAME}/api
# This value is baked into the JS bundle at build time, so it must
# match the public URL the browser will use.
NEXT_PUBLIC_API_URL=http://localhost/api
FRONTEND_PORT=3000
# Set to "false" if you're building behind a corporate TLS-inspection
# proxy (Fortinet / Zscaler / Cisco Umbrella) — npm's strict-ssl will
# otherwise reject the rewritten cert and the build hangs without
# error. Tarball integrity is still SHA-512 verified from the
# lockfile. Default "true" (strict) for clean networks / production.
NPM_STRICT_SSL=true

# ---- Step 13 / R6 measurement knobs (production defaults shown) ----
# Set to false + restart api to record the no-cache baseline for the
# product-detail comparison; flip back to true afterwards.
PRODUCT_CACHE_ENABLED=true
PRODUCT_CACHE_TTL_SECONDS=300

# Set to false + restart api & inventory to bypass the token-bucket
# rate limiter for load tests measuring underlying throughput.
RATE_LIMIT_ENABLED=true

# Set to true + restart inventory to route ReserveStock through
# Postgres SELECT ... FOR UPDATE (R6 flash-sale baseline) instead of
# the Redis Lua atomic path. Always restart between flips so the
# stock-counter bootstrap re-syncs Redis from Postgres.
USE_POSTGRES_STOCK=false
