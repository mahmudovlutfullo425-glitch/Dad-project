{
  "title": "Flash-Sale Operations",
  "uid": "flash-sale",
  "tags": ["flash-sale", "ecommerce"],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "liveNow": false,
  "weekStart": "",
  "timezone": "browser",
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": {},
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "title": "Rate-limit rejections (per rule)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Per-rule rejection rate from the custom token-bucket limiter (R11). A rising line means traffic is being throttled at the edge.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10, "showPoints": "auto" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (rule) (rate(rate_limit_rejected_total[1m]))",
          "legendFormat": "rejected {{rule}}"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (rule) (rate(rate_limit_allowed_total[1m]))",
          "legendFormat": "allowed {{rule}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Stock decrement latency",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "p50 / p95 / p99 of the atomic Redis Lua reserve script inside the inventory service.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(stock_decrement_latency_seconds_bucket[1m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(stock_decrement_latency_seconds_bucket[1m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(stock_decrement_latency_seconds_bucket[1m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 3,
      "title": "Recent traces — POST /flashsales/:id/buy",
      "type": "table",
      "datasource": { "type": "tempo", "uid": "tempo" },
      "description": "TraceQL search for the flash-sale buy path. Click a row to open the full waterfall in Tempo, then jump to the correlated Loki logs.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "tempo", "uid": "tempo" },
          "query": "{ resource.service.name=\"api\" && name =~ \"POST .*buy\" }",
          "queryType": "traceqlSearch",
          "tableType": "traces",
          "limit": 20
        }
      ]
    },
    {
      "id": 4,
      "title": "Service logs (Loki)",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "loki" },
      "description": "Tail of api / inventory / worker logs. `trace_id=...` tokens are clickable — they round-trip you to the trace in Tempo.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{exporter=\"OTLP\"} | json | line_format \"{{.body}}\""
        }
      ]
    }
  ]
}
